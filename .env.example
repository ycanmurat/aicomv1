AICOM_HOST=127.0.0.1
AICOM_PORT=7870
AICOM_OLLAMA_URL=http://127.0.0.1:11434
AICOM_LLM_MODEL=qwen3.5:9b
AICOM_LLM_CONTEXT=8192
AICOM_LLM_MAX_TOKENS=480
AICOM_LLM_TEMPERATURE=0.35

# auto: Whisper for accuracy; nemotron: lower-latency experimental path.
AICOM_STT_PROVIDER=auto
AICOM_WHISPER_MODEL=models/ggml-large-v3-turbo-q8_0.bin
AICOM_NEMO_BINARY=.runtime/nemo-speech/bin/nemo-speech
AICOM_NEMO_MODEL=nemotron-3.5
AICOM_NEMO_MODEL_DIR=models/nemo-cache

# auto/freya: Turkish Freya when installed, with local macOS voice fallback.
# English always uses the configured local macOS voice. none disables all speech.
AICOM_TTS_PROVIDER=auto
# Install both voices in macOS settings before using the app offline.
AICOM_TTS_VOICE=Yelda
AICOM_TTS_VOICE_EN=Samantha
AICOM_TTS_RATE=185
AICOM_FREYA_MODEL=freyavoice/freya-tts
AICOM_FREYA_DEVICE=cpu
AICOM_FREYA_STEPS=16
AICOM_FREYA_ROOT=.runtime/FreyaTTS
AICOM_HF_HOME=models/huggingface

AICOM_KNOWLEDGE_DB=data/knowledge/knowledge.sqlite3
AICOM_AUDIO_ROOT=data/audio
AICOM_LOG_LEVEL=INFO
AICOM_WARMUP=1

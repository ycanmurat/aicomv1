.DS_Store
.env
.env.*
!.env.example
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.log

# Keep local models and downloaded runtimes out of the repository.
models/*
!models/.gitkeep
.runtime/
.cache/

# Keep personal knowledge and generated audio out of the repository.
data/*
!data/knowledge/
data/knowledge/*
!data/knowledge/.gitkeep
!data/audio/
data/audio/*
!data/audio/.gitkeep
